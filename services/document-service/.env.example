# FastAPI document service - local (without Docker) configuration example.
# Copy to .env or export these variables before running uvicorn.

DOCS_ENVIRONMENT=local
DOCS_LOG_LEVEL=DEBUG

# Broker: set to "false" to use the in-memory queue + embedded worker.
DOCS_REDIS_ENABLED=false
DOCS_REDIS_URL=redis://127.0.0.1:6379/0
DOCS_EMBEDDED_WORKER=true

DOCS_EXTERNAL_BASE_URL=http://127.0.0.1:9000
DOCS_EXTERNAL_TIMEOUT_SECONDS=2.0

DOCS_PUBLISH_TIMEOUT_MS=150
DOCS_RETRY_MAX_ATTEMPTS=3
DOCS_RETRY_BASE_DELAY_SECONDS=0.1
DOCS_RETRY_MAX_DELAY_SECONDS=2.0
DOCS_RETRY_JITTER_RATIO=0.2

DOCS_CIRCUIT_FAILURE_THRESHOLD=5
DOCS_CIRCUIT_RECOVERY_SECONDS=30

DOCS_SPOOL_PATH=/tmp/document-spool/pending.jsonl
DOCS_SPOOL_FLUSH_INTERVAL_SECONDS=2.0
DOCS_SPOOL_PUBLISH_TIMEOUT_MS=2000
DOCS_DOCUMENT_DEDUP_TTL_SECONDS=86400

DOCS_REDIS_CONNECT_TIMEOUT_SECONDS=0.5
DOCS_REDIS_SOCKET_TIMEOUT_SECONDS=5.0
