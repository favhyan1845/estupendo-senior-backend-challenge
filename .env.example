# docker compose reads this file automatically (copy to .env to override).
#
# Seed size used by the Laravel entrypoint on first boot.
SEED_INVOICES=100000

# Simulated third-party failure rate (0.3 = 30% of calls return 503).
MOCK_FAILURE_RATE=0.3
MOCK_LATENCY_MS=25

# MySQL credentials
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=estupendo
MYSQL_USER=estupendo
MYSQL_PASSWORD=secret

# Host port mappings (change if they collide with local services)
LARAVEL_PORT=8000
DOCUMENTS_API_PORT=8001
MOCK_EXTERNAL_PORT=9000
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
